{{? sample.hasBody }}	body := strings.NewReader({{= sample.goBody }})

{{?}}	req, err := http.NewRequest(http.Method{{= sample.verb }}, "{{= sample.url }}", {{= sample.hasBody ? 'body' : 'nil' }})
	if err != nil {
		panic(err)
	}
{{~ sample.headers('os.Getenv("SHOTSTACK_API_KEY")', JSON.stringify) :h }}	req.Header.Set("{{= h.name }}", {{= h.value }})
